# Reproducible dependency versions; production services stay separate.
# Override these with registry digest-pinned references in your deployment.
ARG NODE_IMAGE=node:24.19.0-bookworm-slim
ARG PYTHON_IMAGE=python:3.12.9-slim-bookworm
FROM restic/restic:0.19.1 AS backup-client
FROM ${NODE_IMAGE} AS web
WORKDIR /app/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --legacy-peer-deps --no-audit --no-fund
COPY web/ ./
COPY deeptutor/__version__.py /app/deeptutor/__version__.py
ENV DEEPTUTOR_NEXT_DIST_DIR=.next-study NEXT_PUBLIC_API_BASE=http://127.0.0.1:8001 NEXT_TELEMETRY_DISABLED=1
RUN npm run build
EXPOSE 3782
ENV HOSTNAME=0.0.0.0 PORT=3782
CMD ["node", ".next-study/standalone/server.js"]

FROM ${PYTHON_IMAGE} AS study-runtime
WORKDIR /app
COPY requirements/study.lock.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY . /app
ENV DEEPTUTOR_HOME=/runtime DEEPTUTOR_STUDY_RUNTIME=1
EXPOSE 8001
HEALTHCHECK --interval=20s --timeout=3s --start-period=60s CMD python -c "from urllib.request import urlopen; assert urlopen('http://127.0.0.1:8001/health/ready').status == 200"
CMD ["python", "-m", "uvicorn", "deeptutor.api.main:app", "--host", "0.0.0.0", "--port", "8001"]

# One public port for a cloud host. Public requests pass through the session
# check before reaching either Next.js or the API. The local api target below
# remains the default for existing builds.
FROM study-runtime AS hosted
ADD --chmod=0444 --checksum=sha256:fd7b19842b2d465149051f091f2e80fdec08f200e4ff90bf0ac169e8ab207b23 https://raw.githubusercontent.com/mgilbir/tecgonic/b758df17ffa5453b2d2f255f55a6605b80a55a54/wasm/tectonic_wasi.wasm /opt/deeptutor-tectonic/engine.wasm
ADD --chmod=0444 --checksum=sha256:6109880d8a31bbf1f692060ee388d70aac2e64b19031b50cbfce6c2949a4ae76 https://raw.githubusercontent.com/mgilbir/tecgonic/b758df17ffa5453b2d2f255f55a6605b80a55a54/testdata/minibundle.tar.gz /opt/deeptutor-tectonic/format.tar.gz
ADD --chmod=0444 --checksum=sha256:4e9651455e1b761ed462c50f60c4618c8985f46404e8db467def14848e77725a https://raw.githubusercontent.com/mgilbir/tecgonic/b758df17ffa5453b2d2f255f55a6605b80a55a54/LICENSE /opt/deeptutor-tectonic/licenses/tecgonic.txt
COPY --chmod=0755 deployment/tex/runtime.py /usr/local/bin/deeptutor-tectonic
RUN pip install --no-cache-dir 'psycopg[binary]==3.3.9' 'wasmtime==50.0.1' \
    && deeptutor-tectonic --prepare /opt/deeptutor-tectonic
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update -qq \
    && apt-get install -y --no-install-recommends nginx-light supervisor ca-certificates git openssh-client poppler-utils libgomp1 latexmk texlive-xetex texlive-luatex texlive-lang-chinese fonts-lmodern lmodern bubblewrap \
    && python deployment/tex/bundle.py /opt/deeptutor-tectonic/format.tar.gz /usr/share/texlive/texmf-dist /opt/deeptutor-tectonic/bundle /usr/share/texmf \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 --shell /usr/sbin/nologin tutor \
    && install -d -o tutor -g tutor -m 0700 /runtime
COPY --from=web /usr/local/bin/node /usr/local/bin/node
COPY --from=backup-client /usr/bin/restic /usr/local/bin/restic
COPY --from=web /app/web/.next-study/standalone/ /opt/deeptutor-web/
RUN install -d -o tutor -g tutor -m 0700 /opt/deeptutor-web/.next-study/cache/images \
    && chown tutor:tutor /opt/deeptutor-web/.next-study/cache
ENV PORT=8080 PYTHONDONTWRITEBYTECODE=1 NODE_ENV=production
USER tutor
RUN directory="$(mktemp -d)" && cd "$directory" \
    && printf '%s\n' '\documentclass{article}' '\usepackage{graphicx,amsmath}' '\title{Writing fixture}' '\author{Author}' '\begin{document}\maketitle\begin{abstract}Summary.\end{abstract}\section{Method}Paper $x=y$.\end{document}' > paper.tex \
    && SOURCE_DATE_EPOCH=1802822400 /usr/local/bin/deeptutor-tectonic /opt/deeptutor-tectonic/bundle paper.tex \
    && pdftotext paper.pdf - | grep -Fq 'February 17, 2027' \
    && cd / && rm -r "$directory"
EXPOSE 8080
VOLUME ["/runtime"]
HEALTHCHECK --interval=20s --timeout=5s --start-period=120s CMD python -c "import os,urllib.request; assert urllib.request.urlopen('http://127.0.0.1:'+os.environ['PORT']+'/health/ready',timeout=3).status==200"
CMD ["python", "-m", "deployment.hosted.start"]

FROM study-runtime AS api
