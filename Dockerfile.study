# Reproducible dependency versions; production services stay separate.
# Override these with registry digest-pinned references in your deployment.
ARG NODE_IMAGE=node:24.19.0-bookworm-slim
ARG PYTHON_IMAGE=python:3.12.9-slim-bookworm
FROM ${NODE_IMAGE} AS web
WORKDIR /app/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --legacy-peer-deps --no-audit --no-fund
COPY web/ ./
COPY deeptutor/__version__.py /app/deeptutor/__version__.py
ENV DEEPTUTOR_NEXT_DIST_DIR=.next-study NEXT_PUBLIC_API_BASE=http://127.0.0.1:8001 NEXT_TELEMETRY_DISABLED=1
RUN npm run build
EXPOSE 3782
ENV HOSTNAME=0.0.0.0 PORT=3782
CMD ["node", ".next-study/standalone/server.js"]

FROM ${PYTHON_IMAGE} AS study-runtime
WORKDIR /app
COPY requirements/study.lock.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY . /app
ENV DEEPTUTOR_HOME=/runtime DEEPTUTOR_STUDY_RUNTIME=1
EXPOSE 8001
HEALTHCHECK --interval=20s --timeout=3s --start-period=60s CMD python -c "from urllib.request import urlopen; assert urlopen('http://127.0.0.1:8001/health/ready').status == 200"
CMD ["python", "-m", "uvicorn", "deeptutor.api.main:app", "--host", "0.0.0.0", "--port", "8001"]

# One public port for a cloud host. Public requests pass through the session
# check before reaching either Next.js or the API. The local api target below
# remains the default for existing builds.
FROM study-runtime AS hosted
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update -qq \
    && apt-get install -y --no-install-recommends nginx-light supervisor ca-certificates git openssh-client poppler-utils libgomp1 latexmk texlive-xetex bubblewrap \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 --shell /usr/sbin/nologin tutor \
    && install -d -o tutor -g tutor -m 0700 /runtime
COPY --from=web /usr/local/bin/node /usr/local/bin/node
COPY --from=web /app/web/.next-study/standalone/ /opt/deeptutor-web/
ENV PORT=8080 PYTHONDONTWRITEBYTECODE=1 NODE_ENV=production
USER tutor
EXPOSE 8080
HEALTHCHECK --interval=20s --timeout=5s --start-period=120s CMD python -c "import os,urllib.request; assert urllib.request.urlopen('http://127.0.0.1:'+os.environ['PORT']+'/health/ready',timeout=3).status==200"
CMD ["python", "-m", "deployment.hosted.start"]

FROM study-runtime AS api
